; The Last Linea — Godot 4.6.3
config_version=5

[application]
config/name="The Last Linea"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Capítulo I — A floresta que devolve"
config/icon="res://art/linea.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055,0.085,0.095,1)

[autoload]
State="*res://scripts/state.gd"
Sound="*res://scripts/sound.gd"
Updates="*res://scripts/updater.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]
enabled=PackedStringArray("res://addons/linea_updater/plugin.cfg")

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=1024
environment/defaults/default_clear_color=Color(0.055, 0.085, 0.095, 1)

[audio]
driver/enable_input=false
